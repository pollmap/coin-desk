{
  "name": "btc-desk-analysis",
  "main": "worker/collector-entry.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "btc-desk",
      "database_id": "a14897ca-0868-4940-bb6f-ed225ccedf4e",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "BITVIEW_BASE_URL": "https://bitview.space",
    "ENABLED_ASSETS": "BTC,DOGE,ETH,SOL,XRP,LINK,ONDO,PEPE",
    "FEED_URL": "https://coin-desk-feed.lch68-workers.workers.dev",
    "COLLECTOR_LANE": "analysis"
  },
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "FEED_SERVICE",
      "service": "coin-desk-feed",
      "entrypoint": "InternalFeed"
    }
  ]
}
