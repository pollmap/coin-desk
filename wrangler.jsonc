{
  "name": "btc-desk", "main": "worker/index.ts", "compatibility_date": "2026-09-19",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "btc-desk", "database_id": "a14897ca-0868-4940-bb6f-ed225ccedf4e", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "placement": { "region": "aws:ap-northeast-2" },
  "vars": { "BITVIEW_BASE_URL": "https://bitview.space", "ENABLED_ASSETS": "BTC,DOGE,ETH,SOL,XRP,LINK,ONDO,PEPE" }
}
