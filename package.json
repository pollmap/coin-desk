{
  "name": "coin-desk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node scripts/local-api.mjs",
    "dev:cloudflare": "wrangler dev --port 8787",
    "db:local": "node scripts/local-api.mjs --seed",
    "refresh": "node scripts/refresh.mjs",
    "format": "prettier --write src shared worker tests/*.ts tests/*.mjs scripts/*.mjs *.json *.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "tsc -b && vitest run",
    "db:init": "wrangler d1 migrations apply btc-desk --local",
    "seed": "python scripts/bootstrap.py",
    "db:seed": "wrangler d1 execute btc-desk --local --file work/seed.sql",
    "deploy": "npm run build && wrangler deploy && npm run deploy:pages",
    "seed:assets": "python scripts/bootstrap_assets.py",
    "deploy:pages": "wrangler pages deploy --cwd pages --project-name coin-desk --branch main",
    "db:assets": "node scripts/import_assets.mjs"
  },
  "dependencies": {
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1",
    "wrangler": "4.135.0"
  }
}
